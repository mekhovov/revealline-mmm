          "id": "objective",
          "test": {
            "primitiveId": "goal.capture-markers.v1",
            "params": {
              "markerTag": "invoice",
              "targetCount": 2
            }
          }
        }
      ],
      "completion": {
        "mode": "all",
        "goalIds": [
          "coverage",
          "objective"
        ]
      },
      "failure": {
        "zeroLives": true,
        "timerExpiry": "fail"
      }
    }
