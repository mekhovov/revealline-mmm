      "starterPackId": "journey-opening",
      "views": {
        "solo": {
          "campaigns": [
            {
              "source": "candidate",
              "packId": "journey-opening",
              "id": "prologue",
              "title": "Prologue",
              "modes": [
                "solo"
              ],
              "levels": [
                {
                  "id": "first-return",
                  "name": "First return",
                  "hook": "Cross to the far rail or turn back to the near rail?"
                },
                {
                  "id": "choose-your-share",
                  "name": "Choose your share",
                  "hook": "Take the nearby narrow slice now, or travel along the rail for a larger enclosure?"
                },
                {
                  "id": "two-keepers",
                  "name": "Two keepers",
                  "hook": "Separate the two keepers first or wait until they share one side?"
                }
              ]
            },
            {
              "source": "candidate",
              "packId": "journey-opening",
              "id": "horizon-school",
              "title": "Horizon School",
              "modes": [
                "solo"
              ],
              "levels": [
                {
                  "id": "nearby-shore",
                  "name": "Nearby shore",
                  "hook": "Take the short exposed line to the near woven landing, or cross the open gap to establish the larger far landing first?"
                },
                {
                  "id": "island-outpost",
                  "name": "Island outpost",
                  "hook": "Close the short western join from the home panel, or make the longer bent return to the offset eastern stitches before choosing the next enclosure?"
                },
                {
                  "id": "stepping-stones",
                  "name": "Stepping stones",
                  "hook": "Use the near seed landing to build a short spikelet chain, or bypass it for the broader central sun landing before choosing an upper or lower return?"
                },
                {
                  "id": "two-bays",
                  "name": "Two bays",
                  "hook": "Work from the upper offset into the tighter western bay, or descend through the centre and use the lower offset against the wider eastern bay?"
                },
                {
                  "id": "courtyard-return",
                  "name": "Courtyard return",
                  "hook": "Take the short outer bridge first, or move along the ring to choose an inward enclosure?"
                },
                {
                  "id": "long-way-home",
                  "name": "Long way home",
                  "hook": "Join through the upper shoulder group for the shorter first return, or descend to the offset gathered group for a longer line that approaches the far shoulder?"
                }
              ]
            }
          ]
        }
      }
    }
  }
