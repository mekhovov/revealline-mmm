  {
    "brief": "Trace a fictional discrepancy using linked records. This exercise does not prescribe country-specific tax or credit-note rules.",
    "campaignId": "coupa-product-operations",
    "fields": [
      {
        "expected": "Invoice quantity",
        "explanation": "Order and actual receipt agree; the invoice differs.",
        "id": "issue",
        "label": "Discrepancy",
        "options": [
          { "label": "Invoice quantity", "value": "Invoice quantity" },
          { "label": "Receipt quantity", "value": "Receipt quantity" }
        ]
      },
      {
        "expected": "AP requests supplier clarification",
        "explanation": "Preserve correct records while resolving the discrepancy.",
        "id": "handoff",
        "label": "Next action",
        "options": [
          {
            "label": "AP requests supplier clarification",
            "value": "AP requests supplier clarification"
          },
          { "label": "Increase receipt to ten", "value": "Increase receipt to ten" }
        ]
      }
    ],
    "fixtureRevision": "1",
    "format": "revealline-learning-lesson.v1",
    "id": "coupa-product-operations-06-lesson",
    "kind": "practice",
    "missionId": "coupa-product-operations-06",
    "notice": "Fictional, offline training. Illustrative records; no live Coupa actions or certification.",
    "records": [
      {
        "id": "records",
        "lines": [
          "PO-305: 8 lamps. Receipt: 8 lamps. Invoice: 10 lamps.",
          "The invoice has not been paid."
        ],
        "title": "Linked records"
      },
      {
        "id": "policy",
        "lines": [
          "Send a quantity clarification to the supplier through the AP owner.",
          "Do not alter a correct receipt to make the invoice match."
        ],
        "title": "Exception handling for this case"
      }
    ],
    "revision": "2",
    "role": "Accounts payable",
    "sourceReviewedAt": "2026-09-26",
    "sources": [
      {
        "title": "Coupa Supplier Portal — View and manage invoices",
