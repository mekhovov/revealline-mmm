[
  {
    "brief": "Work from a fictional task board. Select the request assigned to your role instead of acting on another team’s notification.",
    "campaignId": "coupa-product-operations",
    "fields": [
      {
        "expected": "R-301",
        "explanation": "Select the task assigned to you.",
        "id": "record",
        "label": "Open record",
        "options": [
          { "label": "R-301", "value": "R-301" },
          { "label": "INV-77", "value": "INV-77" },
          { "label": "R-405", "value": "R-405" }
        ]
      },
      {
        "expected": "Complete delivery address",
        "explanation": "A notification does not necessarily require an action.",
        "id": "action",
        "label": "Work to perform",
        "options": [
          { "label": "Complete delivery address", "value": "Complete delivery address" },
          { "label": "Approve invoice", "value": "Approve invoice" }
        ]
      }
    ],
    "fixtureRevision": "1",
    "format": "revealline-learning-lesson.v1",
    "id": "coupa-product-operations-01-lesson",
