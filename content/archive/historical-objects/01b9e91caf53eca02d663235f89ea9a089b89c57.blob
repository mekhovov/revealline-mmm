  {
    "brief": "Apply the stated policy to a fictional request. The training screen is illustrative, not a replica of a customer instance.",
    "campaignId": "coupa-product-operations",
    "fields": [
      {
        "expected": "Return for clarification",
        "explanation": "The required quote is missing.",
        "id": "decision",
        "label": "Review action",
        "options": [
          { "label": "Return for clarification", "value": "Return for clarification" },
          { "label": "Approve", "value": "Approve" }
        ]
      },
      {
        "expected": "Attach supporting quote",
        "explanation": "Identify the specific missing evidence.",
        "id": "reason",
        "label": "Handoff reason",
        "options": [
          { "label": "Attach supporting quote", "value": "Attach supporting quote" },
          { "label": "Request is too old", "value": "Request is too old" }
