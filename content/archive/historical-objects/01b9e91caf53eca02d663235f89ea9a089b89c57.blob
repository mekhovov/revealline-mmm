        "expected": "Buyer",
        "explanation": "Use the owner specified by the scenario.",
        "id": "owner",
        "label": "Review owner",
        "options": [
          { "label": "Buyer", "value": "Buyer" },
          { "label": "Requester automatically", "value": "Requester automatically" }
        ]
      },
      {
        "expected": "18 October",
        "explanation": "A pending proposal has not replaced the accepted order.",
        "id": "acceptedDate",
        "label": "Current accepted delivery date",
        "options": [
          { "label": "18 October", "value": "18 October" },
          { "label": "21 October", "value": "21 October" }
        ]
      }
    ],
    "fixtureRevision": "1",
    "format": "revealline-learning-lesson.v1",
